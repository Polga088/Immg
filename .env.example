# Immg — Immigration Canada IA

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Docker dev)
DATABASE_URL=postgresql://immg:immg_dev@localhost:5432/immg

# AI Provider: ollama | hybrid | openai
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_ROUTER_MODEL=llama3.2:3b

# Optional fallback (hybrid/openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

# Auth (dev — replace in production)
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=fr
