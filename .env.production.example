# Immg — Production

NODE_ENV=production

# --- Domaine & HTTPS ---
# Sous-domaine pointant vers l'IP du VPS (enregistrement DNS A)
IMMG_DOMAIN=immg.votredomaine.com
CERTBOT_EMAIL=admin@votredomaine.com

# false = HTTP sur :8080 | true = HTTPS Docker (ports 80/443 libres) | host = SSL via nginx système
SSL_ENABLED=false

# Ports exposés (8080 si CRM Texta utilise déjà le port 80)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=443
NGINX_CONF_PATH=./deploy/nginx/immg-http.conf

# URL publique — MUST match IMMG_DOMAIN when SSL is enabled
NEXT_PUBLIC_APP_URL=https://immg.votredomaine.com

DATABASE_URL=postgresql://immg:CHANGE_ME@postgres:5432/immg
POSTGRES_PASSWORD=CHANGE_ME

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_ROUTER_MODEL=llama3.2:3b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=https://immg.votredomaine.com

INGEST_SECRET=CHANGE_ME
IRCC_LIVE_FETCH=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NEXT_PUBLIC_DEFAULT_LOCALE=fr
